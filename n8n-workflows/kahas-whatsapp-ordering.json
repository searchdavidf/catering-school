{
  "name": "Kanhas WhatsApp Ordering",
  "nodes": [
    {
      "parameters": {
        "url": "https://your-domain.com/api",
        "options": {}
      },
      "id": "webhook",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst message = body.message || body.text || '';\nconst from = body.from || body.phone || 'unknown';\nreturn [{ json: { message, from, timestamp: new Date().toISOString() } }];"
      },
      "id": "parse",
      "name": "Parse Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message.toLowerCase();\nlet intent = 'unknown';\n\nif (msg.includes('order') || msg.includes('menu') || msg.includes('food')) {\n  intent = 'order';\n} else if (msg.includes('status') || msg.includes('track')) {\n  intent = 'status';\n} else if (msg.includes('help') || msg.includes('question')) {\n  intent = 'help';\n} else if (msg.includes('cancel')) {\n  intent = 'cancel';\n}\n\nreturn [{ json: { ...$input.first().json, intent } }];"
      },
      "id": "classify",
      "name": "Classify Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "boolean"
          },
          "conditions": [
            {
              "id": "order",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "order",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "route-order",
      "name": "Is Order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://your-domain.com/api",
        "body": {
          "text": "={{ $json.message }}",
          "project": "kanhas",
          "userId": "={{ $json.from }}",
          "role": "customer"
        },
        "options": {}
      },
      "id": "call-api",
      "name": "Call Multi-Bot API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "jsCode": "const apiResponse = $input.first().json;\nconst to = $('Parse Message').first().json.from;\n\nreturn [{ json: { to, message: apiResponse.message || 'Sorry, could not process your order.' } }];"
      },
      "id": "format-reply",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {},
      "id": "whatsapp-reply",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "WhatsApp Webhook": {
      "main": [[{ "node": "Parse Message", "type": "main", "index": 0 }]]
    },
    "Parse Message": {
      "main": [[{ "node": "Classify Intent", "type": "main", "index": 0 }]]
    },
    "Classify Intent": {
      "main": [[{ "node": "Is Order?", "type": "main", "index": 0 }]]
    },
    "Is Order?": {
      "main": [
        [{ "node": "Call Multi-Bot API", "type": "main", "index": 0 }],
        [{ "node": "Format Reply", "type": "main", "index": 0 }]
      ]
    },
    "Call Multi-Bot API": {
      "main": [[{ "node": "Format Reply", "type": "main", "index": 0 }]]
    },
    "Format Reply": {
      "main": [[{ "node": "Send WhatsApp Reply", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
